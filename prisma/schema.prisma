generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nome          String   
  email         String?  @unique
  data_cadastro DateTime @default(now())
}

model Livro {
  id            Int      @id @default(autoincrement())
  titulo        String
  autor         String
  isbn          String?  @unique
  paginas       Int?
  genero        String?
  capa_url      String?
  descricao     String?
  data_adicao   DateTime @default(now())
  pagina_atual  Int      @default(0)
  estado        String   @default("lendo")
}